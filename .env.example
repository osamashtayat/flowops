# Copy to .env (gitignored). Placeholder values only — never commit real secrets.

# PostgreSQL (docker compose)
POSTGRES_DB=flowops
POSTGRES_USER=flowops
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# API settings. ASP.NET Core does NOT read this file: export these into your shell (`set -a; source .env; set +a`)
# or put the same values in dotnet user-secrets (README "Getting started"). Double underscore = config section separator.
# Quoted: the semicolons would otherwise end the line when the file is sourced.
ConnectionStrings__FlowOps="Host=localhost;Port=5432;Database=flowops;Username=flowops;Password=change-me-local-only"
FlowOps__CompanyTimeZone=Asia/Amman
# Bootstrap admin: created on startup only if no Administrator exists (docs/AUTHORIZATION.md §1.6).
# REPLACE the password with a strong one of your own before the first start. The app refuses to start while it is still
# this placeholder (it is public). Leave both empty to create no admin.
FlowOps__BootstrapAdmin__Email=admin@flowops.local
FlowOps__BootstrapAdmin__Password=CHANGE-ME-before-first-start

# Optional: open SignalR connections per user (default 10, #55)
# FlowOps__Realtime__MaxConnectionsPerUser=10

# Full stack in Docker (docker compose up -d --build, OPS-01)
# Required: the api's ASPNETCORE_ENVIRONMENT. Production (strict CSP, no OpenAPI, no demo data) or Development.
FLOWOPS_ENVIRONMENT=Production
# FLOWOPS_WEB_PORT=8443                # https://localhost:8443

# Frontend dev proxy target (src/frontend/vite.config.ts)
FLOWOPS_API_URL=https://localhost:7180
