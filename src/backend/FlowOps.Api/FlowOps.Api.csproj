<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Local secrets (connection string, bootstrap admin) live in dotnet user-secrets, never in appsettings. -->
    <UserSecretsId>flowops-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <!-- Infrastructure is referenced only for composition-root DI registration (ARCHITECTURE.md §3). -->
  <ItemGroup>
    <ProjectReference Include="..\FlowOps.Application\FlowOps.Application.csproj" />
    <ProjectReference Include="..\FlowOps.Infrastructure\FlowOps.Infrastructure.csproj" />
  </ItemGroup>

</Project>
